<Window x:Class="RobotInterface_meh_diop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RobotInterface_meh_diop"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition/>

            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>


        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="1*"/>

        </Grid.ColumnDefinitions>
        <GroupBox x:Name="Emission" Header="Emission" Margin="0" Background="#FFDDDDDD" BorderBrush="Black" Grid.Row="1" Grid.ColumnSpan="2" >
            <TextBox x:Name="textBoxEmission" TextWrapping="Wrap" AcceptsReturn="True" Width="Auto" Height="Auto" Margin="0" HorizontalAlignment="Stretch"/>
        </GroupBox>
        <GroupBox x:Name="Réception" Header="Réception" Margin="0" Grid.Column="2" BorderBrush="Black" Background="#FFDDDDDD" Grid.Row="1" Grid.ColumnSpan="2">
            <TextBox x:Name="textBoxReception" TextWrapping="Wrap" IsReadOnly="True" Width="Auto" Height="Auto" Margin="0" HorizontalAlignment="Stretch"/>
        </GroupBox>
        <Button x:Name="buttonEnvoyer" Content="Envoyer" Grid.RowSpan="2" Grid.Column="1" Margin="10,10,10,0" Grid.Row="2"/>

    </Grid>
</Window>
